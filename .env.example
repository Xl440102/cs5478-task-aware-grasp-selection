# Copy to .env in the project root and fill in your Gemini key locally.
# GPT uses the existing ChatGPT login through Codex CLI by default: codex login.
# Existing exported environment variables take precedence over .env values.
GEMINI_API_KEY=

# Optional: only for configs/c.openai.json or configs/c.api.json.
# The OpenAI API is billed separately; this key is NOT needed by the default workflow.
# OPENAI_API_KEY=
