    "stages": [
      {
        "id": "pregrasp",
        "actor": "donor",
        "action": "Move to estimated pregrasp; jaws open",
        "entry": "Fresh scene and selected candidate feasible",
        "control_exit": "TCP arrival sustained",
        "evaluation": "No unintended collision",
        "timeout_s": 3,
        "allowed_contacts": [
          "source_table"
        ]
      },
      {
        "id": "approach",
        "actor": "donor",
        "action": "Move to estimated candidate grasp pose",
        "entry": "pregrasp control completed",
        "control_exit": "TCP arrival sustained",
        "evaluation": "No nonfinger source collision",
        "timeout_s": 3,
        "allowed_contacts": [
          "donor_fingers_source",
          "source_table"
        ]
      },
      {
        "id": "close",
        "actor": "donor",
        "action": "Close jaws under force-limited motor control",
        "entry": "approach control completed",
        "control_exit": "Fixed 0.75 s close; encoder feedback only",
        "evaluation": "Physical source/finger contact formed",
        "timeout_s": 1,
        "allowed_contacts": [
          "donor_fingers_source",
          "source_table"
        ]
      },
      {
        "id": "lift",
        "actor": "donor",
        "action": "Raise nominal source by 0.14 m",
        "entry": "close action completed, not an oracle grasp gate",
        "control_exit": "TCP arrival sustained",
        "evaluation": "Source lifted >=0.09 m with donor contact",
        "timeout_s": 4,
        "allowed_contacts": [
          "donor_fingers_source"
        ]
      },
      {
        "id": "transport",
        "actor": "donor",
        "action": "Move upright source from A to the B work region",
        "entry": "lift control completed",
        "control_exit": "TCP arrival sustained",
        "evaluation": "Source near prescribed B pose; no drop/collision",
        "timeout_s": 4,
        "allowed_contacts": [
          "donor_fingers_source"
        ]
      },
      {
        "id": "receiver_approach",
        "actor": "receiver",
        "action": "Motorized Y rail approaches known B handle region; jaws open",
        "entry": "donor transport control completed",
        "control_exit": "Receiver rail encoder reaches target",
        "evaluation": "No donor/receiver collision or nonfinger source contact",
        "timeout_s": 2,
        "allowed_contacts": [
          "donor_fingers_source"
        ]
      },
      {
        "id": "receiver_close",
        "actor": "receiver",
        "action": "Close synchronized upper/lower fingers on handle",
        "entry": "receiver approach control completed",
        "control_exit": "Fixed 0.75 s force-limited close",
        "evaluation": "At least one receiver finger contacts handle; both required after donor release",
        "timeout_s": 1,
        "allowed_contacts": [
          "donor_fingers_source",
          "receiver_fingers_handle"
        ]
      },
      {
        "id": "donor_release",
        "actor": "donor",
        "action": "Open donor jaws",
        "entry": "receiver close action completed, no truth-based gate",
        "control_exit": "Fixed 0.5 s open",
        "evaluation": "Receiver support maintained; donor release is intentional",
        "timeout_s": 1,
        "allowed_contacts": [
          "donor_fingers_source",
          "receiver_fingers_handle"
        ]
      },
      {
        "id": "retreat",
        "actor": "donor",
        "action": "Withdraw 0.10 m along approach axis and raise 0.16 m",
        "entry": "donor release completed",
        "control_exit": "TCP arrival sustained",
        "evaluation": "Donor detached and clear",
        "timeout_s": 4,
        "allowed_contacts": [
          "receiver_fingers_handle"
        ]
      },
      {
        "id": "receiver_lift",
        "actor": "receiver",
        "action": "Raise Z rail by configured distance",
        "entry": "donor retreat control completed",
        "control_exit": "Receiver rail encoder reaches target",
        "evaluation": "Source actually rises with receiver",
        "timeout_s": 2,
        "allowed_contacts": [
          "receiver_fingers_handle"
        ]
      },
      {
        "id": "settle",
        "actor": "all_actuators",
        "action": "Keep final motor targets for a fixed settling interval",
        "entry": "last physical action control completed",
        "control_exit": "Fixed settle_s; no oracle stability gate",
        "evaluation": "Continue collision/drop sampling; no terminal stability score yet",
        "timeout_s": 1.0,
        "allowed_contacts": [
          "receiver_fingers_handle"
        ]
      },
      {
        "id": "terminal",
        "actor": "evaluator",
        "action": "Observe recipient-only support",
        "entry": "settle control completed",
        "control_exit": "Fixed terminal window",
        "evaluation": "Every step: recipient contact, donor detached, height, B pose, upright and speed limits",
        "timeout_s": 1.0,
        "allowed_contacts": [
          "receiver_fingers_handle"
        ]
      }
    ],
    "policy": "ID-only; same sequence/observation/limits for all selectors; no donor regrasp",
    "note": "Stage evaluation never controls transitions. Thresholds come from config, not labels."
