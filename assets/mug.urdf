<?xml version="1.0"?>
<robot name="simple_mug">
  <!-- A solid proxy. The rim is visual only; no fluid or hollow cup physics. -->
  <link name="mug">
    <inertial>
      <origin xyz="0 0 0"/>
      <mass value="0.28"/>
      <inertia ixx="0.00035" iyy="0.00035" izz="0.00022" ixy="0" ixz="0" iyz="0"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0"/>
      <geometry><cylinder radius="0.035" length="0.09"/></geometry>
      <material name="blue"><color rgba="0.17 0.44 0.70 1"/></material>
    </visual>
    <collision>
      <origin xyz="0 0 0"/>
      <geometry><cylinder radius="0.035" length="0.09"/></geometry>
    </collision>
    <!-- Handle points along +Y in the mug's own coordinates. -->
    <visual>
      <origin xyz="0 0.060 0.029"/>
      <geometry><box size="0.012 0.055 0.012"/></geometry>
      <material name="blue"/>
    </visual>
    <visual>
      <origin xyz="0 0.060 -0.029"/>
      <geometry><box size="0.012 0.055 0.012"/></geometry>
      <material name="blue"/>
    </visual>
    <visual>
      <origin xyz="0 0.086 0"/>
      <geometry><box size="0.012 0.012 0.069"/></geometry>
      <material name="blue"/>
    </visual>
    <collision><origin xyz="0 0.060 0.029"/><geometry><box size="0.012 0.055 0.012"/></geometry></collision>
    <collision><origin xyz="0 0.060 -0.029"/><geometry><box size="0.012 0.055 0.012"/></geometry></collision>
    <collision><origin xyz="0 0.086 0"/><geometry><box size="0.012 0.012 0.069"/></geometry></collision>
  </link>
</robot>
